# CycloneAI — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── General ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.4.0-phase4
DEMO_MODE=false

# CORS — comma-separated origins locally. In Render, use a JSON list such as
# CORS_ORIGINS=["https://your-vercel-project.vercel.app"]
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (development — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./cycloneai.db

# PostgreSQL (production — recommended for deployment):
# DATABASE_URL=postgresql+asyncpg://cyclone_user:yourpassword@localhost:5432/cycloneai

# ── IBTrACS Provider (NOAA NCEI — public, no auth required) ─────────────────
IBTRACS_BASE_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv/
IBTRACS_ACTIVE_FILE=ibtracs.ACTIVE.list.v04r01.csv
IBTRACS_NI_FILE=ibtracs.NI.list.v04r01.csv
# How often to refresh ACTIVE file (hours)
IBTRACS_ACTIVE_REFRESH_HOURS=6
IBTRACS_HISTORICAL_REFRESH_HOURS=24

# ── RSMC New Delhi Bulletin Scraper ──────────────────────────────────────────
# Set to true to enable text bulletin scraping from RSMC New Delhi.
# WARNING: fragile — bulletin format may change without notice.
# Only enable when an active NI storm is expected.
RSMC_BULLETIN_ENABLED=false
RSMC_BULLETIN_URL=https://rsmcnewdelhi.imd.gov.in
RSMC_BULLETIN_REFRESH_HOURS=3

# ── MOSDAC / ISRO (satellite data — Phase 2b) ────────────────────────────────
# Register at https://www.mosdac.gov.in to obtain credentials.
# General users have 3-day latency; privileged users get NRT access.
# Leave blank until you have a registered account.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_API_URL=https://www.mosdac.gov.in
# Keep disabled until credentials and a download workflow have been verified.
MOSDAC_ENABLED=false
# Discovery can use MOSDAC's public catalog. Downloads require credentials and
# should remain disabled until a persistent disk/object store is configured.
MOSDAC_DOWNLOAD_ENABLED=false
# Required only for the protected discover/download API actions; choose a long
# random value and set it only in the backend environment.
SATELLITE_ADMIN_TOKEN=
MOSDAC_REQUEST_TIMEOUT_SECONDS=60
# Public source catalog refresh. This stores metadata only and never downloads HDF products.
MOSDAC_DISCOVERY_REFRESH_MINUTES=60

# ── Satellite source-product storage (Phase 3) ─────────────────────────────
# Local development path for raw MOSDAC products and derived web assets.
# On Render this must be a persistent disk or object-storage-backed mount.
SATELLITE_STORAGE_DIR=data/satellite
# Refuse a product download larger than this value once the ingest worker is enabled.
SATELLITE_MAX_DOWNLOAD_MB=2048

# ── IMD API (ip-whitelisted — formal application required) ───────────────────
# Contact: Dr. Sankar Nath (sankar.nath@imd.gov.in)
# Requires IP whitelisting — not self-service.
# IMD_API_URL=https://api.imd.gov.in
# IMD_API_KEY=

# ── Data Freshness Thresholds ────────────────────────────────────────────────
# Observation is LIVE if received within this many hours
DATA_LIVE_THRESHOLD_HOURS=6
# Observation is DELAYED if within this many hours (else STALE)
DATA_DELAYED_THRESHOLD_HOURS=24

# ── AI detection (Phase 4) ───────────────────────────────────────────────────
# A detector remains unavailable until models/detection/best.pt is produced by
# the event-split training command. Do not add a checkpoint to Git.
AI_MODEL_DIR=../models
AI_DEVICE=auto
AI_MAX_IMAGE_MB=10

# ── New APIs (Phase 5) ──────────────────────────────────────────────────────
# /api/cyclones/search — max results per query
SEARCH_MAX_RESULTS=100

# /api/cyclones/{id}/alerts — IMD colour-coded warning thresholds (km/h)
# Based on IMD's actual warning scale. Green = no warning.
ALERT_YELLOW_WIND_KMH=62
ALERT_ORANGE_WIND_KMH=88
ALERT_RED_WIND_KMH=118

# /api/cyclones/{id}/risk-zones — default wind radii (km) for concentric rings
RISK_ZONE_RADII_KM=[350, 200, 100]

# /api/statistics/seasonal — earliest year for seasonal queries
STATS_MIN_YEAR=2000

# /api/export — allowed export formats (csv, geojson, json)
EXPORT_FORMATS=csv,geojson,json
