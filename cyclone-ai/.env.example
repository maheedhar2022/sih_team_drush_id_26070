# ============================================================
# CycloneAI — Environment Variables
# Copy this file to .env and fill in values before running.
# NEVER commit .env to source control.
# ============================================================

# --- General ---
APP_ENV=development
DEMO_MODE=true

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Phase 1: SQLite by default (set to postgres URL when ready)
DATABASE_URL=sqlite:///./cyclone_ai.db

# --- Cache ---
# REDIS_URL=redis://localhost:6379/0

# --- Data Sources ---
# MOSDAC / ISRO satellite data key (register at https://www.mosdac.gov.in/)
MOSDAC_API_KEY=

# IBTrACS data URL (public, no auth required)
IBTRACS_BASE_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv/

# --- AI / Model ---
AI_MODEL_DIR=../models
AI_DEVICE=auto   # auto | cuda | cpu
