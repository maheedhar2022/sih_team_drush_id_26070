{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd cyclone-ai/frontend && npm ci",
  "buildCommand": "cd cyclone-ai/frontend && npm run build",
  "outputDirectory": "cyclone-ai/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
